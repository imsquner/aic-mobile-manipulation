                          "taskPlanJson": {
                            "type": "RawMessage",
                            "config": {
                              "topic": "/competition/task_plan_json",
                              "label": "Structured Task (JSON)"
                            }
                          },
                          "detectionImage": {
                            "type": "Image",
                            "config": {
                              "topic": "/competition/detection_image",
                              "label": "Detection View"
                            }
                          },
                          "rgbImage": {
                            "type": "Image",
                            "config": {
                              "topic": "/camera_rgbd/camera_rgbd/image_raw",
                              "label": "RGB Camera"
                            }
                          },
                          "depthImage": {
                            "type": "Image",
                            "config": {
                              "topic": "/camera_rgbd/camera_rgbd/depth/image_raw",
                              "label": "Depth"
                            }
                          },
                          "map3D": {
                            "type": "Map3D",
                            "config": {
                              "topic": "/map",
                              "label": "3D Map"
                            }
                          },
                          "laserScan": {
                            "type": "LaserScan",
                            "config": {
                              "topic": "/scan",
                              "label": "LiDAR Scan"
                            }
                          },
                          "globalPath": {
                            "type": "Path",
                            "config": {
                              "topic": "/plan",
                              "label": "Global Path"
                            }
                          },
                          "localPath": {
                            "type": "Path",
                            "config": {
                              "topic": "/local_plan",
                              "label": "Local Path"
                            }
                          },
                          "eventLog": {
                            "type": "Log",
                            "config": {
                              "topic": "/competition/event",
                              "label": "Event Log"
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "controlBar": {
                  "type": "tab",
                  "tabs": [
                    {
                      "title": "Controls",
                      "layout": {
                        "version": 1,
                        "panels": {
                          "mappingInput": {
                            "type": "Publish",
                            "config": {
                              "topic": "/competition/mapping_rule_input",
                              "label": "Mapping Rule Input"
                            }
                          },
                          "manualQuestion": {
                            "type": "Publish",
                            "config": {
                              "topic": "/competition/manual_question",
                              "label": "Manual Question"
                            }
                          },
                          "startButton": {
                            "type": "Publish",
                            "config": {
                              "topic": "/competition/start",
                              "label": "Start Task",
                              "buttonText": "START",
                              "message": "true"
                            }
                          },
                          "resubmitButton": {
                            "type": "Publish",
                            "config": {
                              "topic": "/competition/resubmit",
                              "label": "Retry Current Question",
                              "buttonText": "RESUBMIT",
                              "message": "true"
                            }
                          },
                          "cancelButton": {
                            "type": "Publish",
                            "config": {
                              "topic": "/competition/cancel",
                              "label": "Cancel Task",
                              "buttonText": "CANCEL"
                            }
                          },
                          "resetButton": {
                            "type": "Publish",
                            "config": {
                              "topic": "/competition/reset",
                              "label": "Reset",
                              "buttonText": "RESET"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
