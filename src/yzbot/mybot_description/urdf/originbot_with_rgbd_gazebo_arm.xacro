<?xml version="1.0"?>
<robot name="six_arm"
    xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find mybot_description)/urdf/large_base_gazebo.xacro" />
    <xacro:include filename="$(find mybot_description)/urdf/rgbd_gazebo.xacro" />
    <xacro:include filename="$(find mybot_description)/urdf/camera_gazebo.xacro" />
    <xacro:include filename="$(find mybot_description)/urdf/lidar_gazebo.xacro" />
    <xacro:include filename="$(find mybot_description)/urdf/arm_gazebo.xacro" />

    <!-- rgbd -->
    <!-- `params/camera.md` 定案：rgbd_joint 相对 grasping_frame 的
         xyz = (+0.090, 0.000, -0.020) m，joint pitch = -1.01646 rad
         (= -58.239 deg = -M_PI/2 + 0.6416)。

         注意下面这个双重取负：`rgbd_offset_x` 为负值，origin 又写 `-rgbd_offset_x`，
         两者相乘才得到定案要求的 **+0.090**。2026-09-23 之前的版本把这里写成
         正 0.09，结果相机落到 -0.09，方向装反。改动此处务必重新核对符号。 -->
    <xacro:property name="rgbd_offset_x" value="-0.09" />
    <xacro:property name="rgbd_offset_y" value="0" />
    <xacro:property name="rgbd_offset_z" value="-0.02" />
    <xacro:property name="rgbd_tilt" value="${-5.0*M_PI/180.0}" />

    <joint name="rgbd_joint" type="fixed">
        <!-- Eye-in-hand camera on the back of the tool. The -5 deg tilt is what
             makes the total pitch land exactly on the camera.md value:
             -M_PI/2 + 0.6416 - 5 deg = -1.01646 rad. -->
        <origin xyz="${-rgbd_offset_x} ${rgbd_offset_y} ${rgbd_offset_z}"
                rpy="0 ${-M_PI/2 + 0.6416 + rgbd_tilt} 0" />
        <parent link="grasping_frame" />
        <child link="camera_rgbd_link" />
    </joint>

    <xacro:rgbd_camera prefix="camera_rgbd" />

    <!-- Camera -->
    <xacro:property name="camera_offset_x" value="${base_length/2+0.02}" />
    <xacro:property name="camera_offset_y" value="0" />
    <xacro:property name="camera_offset_z" value="-0.01" />

    <joint name="camera_joint" type="fixed">
        <origin xyz="${camera_offset_x} ${camera_offset_y} ${camera_offset_z}" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="camera_link" />
    </joint>

    <xacro:mipi_camera prefix="camera" />

    <!-- Lidar -->
    <xacro:property name="lidar_offset_x" value="0" />
    <xacro:property name="lidar_offset_y" value="0" />
    <xacro:property name="lidar_offset_z" value="${base_height/2+0.01}" />
    <xacro:property name="robot_radius" value="${(base_length**2 + base_width**2)**0.5 / 2}" />
    <xacro:property name="safety_margin" value="0.05" />

    <joint name="lidar_joint" type="fixed">
        <origin xyz="${lidar_offset_x} ${lidar_offset_y} ${lidar_offset_z}" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="laser_link" />
    </joint>

    <xacro:lidar prefix="laser" gz_visualize="false" range_min="0.5" />
    <!-- <xacro:lidar prefix="laser" gz_visualize="false" range_min="${robot_radius +
    safety_margin}" /> -->

    <!-- arm -->
    <xacro:property name="arm_offset_x" value="0.0" />
    <xacro:property name="arm_offset_y" value="0" />
    <xacro:property name="arm_offset_z" value="${base_height/2+0.01}" />

    <joint name="connect_joint" type="fixed">
        <origin xyz="${arm_offset_x} ${arm_offset_y} ${arm_offset_z}" rpy=" 0 0 0" />
        <parent link="base_link" />
        <child link="arm_base_link" />
    </joint>

</robot>
